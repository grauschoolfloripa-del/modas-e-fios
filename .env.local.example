# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NUNCA é commitado no Git (já está no .gitignore).

# Supabase — Project Settings > Data API (URL) e Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada para links de e-mail e retorno do Mercado Pago).
# Em produção na Vercel, use o domínio real; em desenvolvimento, o padrão já funciona.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# As chaves do Mercado Pago NÃO vão aqui — são adicionadas depois,
# pela tela /admin/configuracoes, e ficam guardadas no banco de dados.
